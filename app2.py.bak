app = Flask(__name__)
DB_FILE = "users.db"
lock = threading.Lock()

# --- CONFIGURATION ---
EXTERNAL_API_URL = "http://54.163.45.50:5555/attack"
SECRET_API_KEY = "tEkPkWaEzlgs9VV9dTkh08YmIlHPOcvF"
IST_OFFSET = 19800  # 5.5 hours for IST
LATEST_VERSION_CODE = 6
