    response = "<b>🏆 वोल्लाह! BGMI सर्वर को अंटार्कटिका बनाने वाले हबीबी 🏆</b>\n\n"

    response += "<b>📅 आज के टॉप 5 खतरनाक हबीबी</b>\n"
