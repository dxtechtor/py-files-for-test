    if len(command_parts) < 2:
        current_key = get_setting('api_key', _API_KEY)
        safe_send_message(message.chat.id, f"⚠️ Usage: /key <new_key>\nCurrent Key: `{current_key}`", reply_to=message, parse_mode="Markdown")
